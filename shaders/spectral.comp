#version 450
// Spectral stages: 81-wavelength transmission through a dye stack.
//   mode 0 (print exposure): film density -> print raw exposure
//       out[m] = (max(sum_l T_l * R[l][m] * gain[m] + preflash[m], 0) + 1e-10) * scale
//   mode 1 (scan): density -> CIE XYZ (with the black / white correction on Y)
//       out[m] = max(sum_l T_l * R[l][m], 0) + 1e-10
// with T_l = 10^-(sum_k d_k * cd[l][k] + base[l] + silver). Wavelengths whose
// data are undefined (NaN upstream) are baked as zero response on the CPU.
// The Extended bleach bypass changes the dye densities and adds neutral silver.
#include "common.glsl"
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0) readonly buffer B0 { float d[]; } S;   // densities, c channels
layout(set = 0, binding = 2) buffer B2 { float d[]; } O;            // n_out channels
layout(set = 0, binding = 3) readonly buffer B3 { float d[]; } D;   // [81][4]: channel densities (3) + base
layout(set = 0, binding = 4) readonly buffer B4 { float d[]; } R;   // [81][3]: response per output channel
layout(set = 0, binding = 7) readonly buffer B7 { float p[]; } P;   // gain[3] @0, preflash[3] @3, dmax[3] @6

void main() {
    uint w = pc.u[0], h = pc.u[1], c = pc.u[2], mode = pc.u[3], nout = pc.u[4];
    uvec2 g = gl_GlobalInvocationID.xy;
    if (g.x >= w || g.y >= h) return;
    uint base = (g.y * w + g.x) * c;
    vec3 d = vec3(0.0);
    for (uint k = 0u; k < c; ++k) d[k] = S.d[base + k];
    float silver = 0.0;
    uint bleach = pc.u[5];  // 0 off, 1 film stage, 2 print stage
    if (bleach != 0u) {
        bool printStage = bleach == 2u, positive = pc.u[6] != 0u;
        float amount = clamp(pc.f[1], 0.0, 1.0);
        float shoulder = printStage ? 0.65 : 0.85;
        float retained = 0.0, black = -1e30;
        for (uint k = 0u; k < c; ++k) {
            float sv = (!printStage && positive) ? max(P.p[6u + k] - d[k], 0.0) : max(d[k], 0.0);
            retained += sv / (sv + shoulder);
            black = max(black, d[k]);
        }
        retained /= float(c);
        silver = amount * (printStage ? 0.36 : 0.22) * retained;
        float blackAmount = clamp(amount * retained, 0.0, 1.0);
        float cyan0 = d[0];
        for (uint k = 0u; k < c; ++k) d[k] = mix(d[k], black, blackAmount);
        if (!printStage && !positive && c == 3u) {
            float drive = clamp(max(cyan0, 0.0) / max(P.p[6], 1e-6), 0.0, 1.0);
            float coupling = clamp(pc.f[2], 0.0, 2.0);
            d[0] = max(d[0] - min(amount * coupling * 0.30 * drive, 0.30 * coupling), 0.0);
        }
    }
    vec3 acc = vec3(0.0);
    for (uint l = 0u; l < 81u; ++l) {
        float dens = D.d[l * 4u + 3u] + silver;
        for (uint k = 0u; k < c; ++k) dens += d[k] * D.d[l * 4u + k];
        float t = exp2(-dens * LOG2_10);
        acc += t * vec3(R.d[l * 3u], R.d[l * 3u + 1u], R.d[l * 3u + 2u]);
    }
    uint o = (g.y * w + g.x) * nout;
    if (mode == 0u) {
        for (uint m = 0u; m < nout; ++m)
            O.d[o + m] = (max(acc[m] * P.p[m] + P.p[3u + m], 0.0) + 1e-10) * pc.f[0];
    } else {
        vec3 xyz = max(acc, vec3(0.0)) + vec3(1e-10);
        if (pc.u[7] != 0u) {
            float yc = clamp(pc.f[3] * xyz.y + pc.f[4], 0.0, 1.0);
            xyz *= yc / (xyz.y + 1e-10);
        }
        O.d[o] = xyz.x;
        O.d[o + 1u] = xyz.y;
        O.d[o + 2u] = xyz.z;
    }
}
